{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "swarm",
  "main": "src/worker.ts",
  "rules": [{ "type": "Text", "globs": ["**/dashboard.html"], "fallthrough": true }],
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["nodejs_compat"],
  "secrets": {
    "required": [
      "ACK3_CODEX_AUTH_JSON",
      "CONTROL_API_TOKEN"
    ]
  },
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "limits": {
    "cpu_ms": 300000,
    "subrequests": 10000000
  },
  "vars": {
    "ACK3_CODEX_WORKSPACE_ID": "set-by-cloudflare-environment"
  },
  "r2_buckets": [
    {
      "binding": "PACKAGES",
      "bucket_name": "swarm-experiment-packages"
    },
    {
      "binding": "ARTIFACTS",
      "bucket_name": "swarm-experiment-artifacts"
    }
  ],
  "d1_databases": [
    {
      "binding": "INDEX",
      "database_name": "swarm-experiment-index",
      "database_id": "set-by-terraform-output"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATORS",
        "class_name": "ExperimentCoordinator"
      },
      {
        "name": "AGENT_SANDBOX",
        "class_name": "AgentSandbox"
      }
    ]
  },
  "containers": [
    {
      "name": "swarm-agent-sandbox",
      "class_name": "AgentSandbox",
      "scheduling_policy": "durable_object",
      "images": {
        "sandbox": { "dockerfile": "./Dockerfile" }
      }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExperimentCoordinator", "Sandbox"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["AgentSandbox"]
    }
  ],
  "workflows": [
    {
      "binding": "AUDIT_WORKFLOW",
      "name": "swarm-audit-workflow",
      "class_name": "AuditWorkflow"
    }
  ]
}
